# ── Application ─────────────────────────────────────────────────
APP_NAME="PersonSearch API"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/personsearch
DB_ECHO=false

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth ─────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AI ───────────────────────────────────────────────────────────
AI_PROVIDER=google
GOOGLE_API_KEY=your-google-api-key-here
AI_MODEL_EXTRACTION=gemini-2.0-flash
AI_MODEL_REASONING=gemini-2.5-pro

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173"]
